# 推荐。OpenAlex 免费 Key（官方已要求，匿名调用随时可能收紧）
# 申请: https://openalex.org/settings/api  （约 1 分钟，免费额度 $1/天）
OPENALEX_API_KEY=

# 推荐。AMiner 免费 Key，覆盖中英文文献
# 申请: https://open.aminer.cn/open/board?tab=control  （约 2 分钟）
AMINER_API_KEY=

# 可选。填邮箱进入 OpenAlex/Crossref 礼貌池，速率更稳定
LITSEARCH_MAILTO=

# 可选但推荐。Semantic Scholar 免费 Key（无 Key 时 S2 源常年 429 不可用）
# 申请: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
